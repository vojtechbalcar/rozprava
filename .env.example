# Run `uv run python scripts/local_db.py init` to generate private local credentials.
# DATABASE_URL=postgresql+psycopg://rozprava:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/rozprava
# TEST_DATABASE_URL=postgresql+psycopg://rozprava:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/rozprava_test
# ROZPRAVA_DATA_DIR=~/.local/share/rozprava
# ROZPRAVA_CACHE_DIR=~/.local/share/rozprava/cache

# Paid AI services (docs/related-search.md). Put real keys only in the private .env.
# VOYAGE_API_KEY=pa-...                     # meaning search (embeddings)
# ANTHROPIC_API_KEY=sk-ant-...              # cited summaries
# ROZPRAVA_EMBEDDING_MODEL=voyage-4-large
# ROZPRAVA_EMBEDDING_TOKEN_LIMIT=190000000  # stays inside Voyage's free 200 M tokens
# ROZPRAVA_AI_MONTHLY_LIMIT_USD=5           # Claude summaries per calendar month
